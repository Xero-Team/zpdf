  "findings": [
    {
      "id": "R01",
      "priority": "P1",
      "prs": [
        113
      ],
      "description": "Partial form filling deleted stored appearances on untouched widgets when NeedAppearances was true.",
      "fix": "Preserve untouched appearance dictionaries, including custom artwork and embedded fonts.",
      "regression": "forms::tests::filling_one_field_preserves_an_untouched_stored_appearance"
    },
    {
      "id": "R02",
      "priority": "P1",
      "prs": [
        108
      ],
      "description": "Repeated source indices appended the same page object twice, breaking stable page identities and subsequent deletion counts.",
      "fix": "Reject duplicate source indices before copying or editing the page tree.",
      "regression": "duplicate_source_pages_are_rejected_before_the_page_tree_changes"
    },
    {
      "id": "R03",
      "priority": "P1",
      "prs": [
        123
      ],
      "description": "CLI text, search and tables did not pass the optional-content configuration, exposing disabled-layer text.",
      "fix": "Use the document's default layer visibility in all three extraction entry points.",
      "regression": "text_search_and_tables_exclude_disabled_layers"
    },
    {
      "id": "R04",
      "priority": "P1",
      "prs": [
        123
      ],
      "description": "Desktop previews used a separate interpretation path with incorrect annotation placement, missing generated appearances, hidden-layer visibility and UserUnit handling.",
      "fix": "Reuse the shared page pipeline and reject known incomplete previews before GPU initialization.",
      "regression": "preview_honors_layers_annotations_rotation_and_user_units; incomplete_preview_is_rejected_before_rendering"
    },
    {
      "id": "R05",
      "priority": "P1",
      "prs": [
        119
      ],
      "description": "Text and marked-content ActualText inside soft-mask painting resources entered the logical extraction sink.",
      "fix": "Suspend text and rule extraction while interpreting the mask group.",
      "reproduction_before": "MASK_ONLYMASK_REPLACEMENT\\nVISIBLE",
      "reproduction_after": "VISIBLE",
      "regression": "soft_mask_text_and_actual_text_are_paint_resources_only"
    },
    {
      "id": "R06",
      "priority": "P1",
      "prs": [
        120
      ],
      "description": "Regenerating annotations with damaged required geometry could replace an existing visible appearance with an empty stream.",
      "fix": "Validate required point arrays before changing appearances, and preserve output on failure.",
      "regression": "malformed_geometry_does_not_erase_a_stored_appearance"
    },
    {
      "id": "R07",
      "priority": "P2",
      "prs": [
        123
      ],
      "description": "Non-stream XObjects were silently omitted without diagnostics; hidden draws could incorrectly report missing resources.",
      "fix": "Record visible object failures with object IDs and skip hidden draws before resource lookup.",
      "regression": "malformed_xobjects_are_reported_but_hidden_draws_are_not_failures"
    },
    {
      "id": "R08",
      "priority": "P2",
      "prs": [
        124
      ],
      "description": "The packaged WASM fingerprint omitted embedded CMap data outside src directories.",
      "fix": "Hash embedded data directories, add an isolated asset-change regression and regenerate matching JS/WASM.",
      "regression": "changes to embedded assets outside src invalidate the WASM fingerprint"
    },
    {
      "id": "R09",
      "priority": "P1",
      "branch": "fix/audit-headless-native-backends",
      "description": "Concurrent headless adapter requests panicked in EGL make_current with BadAccess while enumerating unused GLES adapters.",
      "fix": "Prefer shared native-backend instances, retain GLES fallback when no native adapter exists, and honor WGPU_BACKEND.",
      "regression": "concurrent_headless_adapter_requests_do_not_panic; workspace GPU oracle suites"
    },
    {
      "id": "R10",
      "priority": "P1",
      "prs": [
        125,
        126
      ],
      "description": "Dependency PR #125 upgrades RSA digest compatibility consumers to sha2 0.11 and fails trait bounds; #126 removes a required libc pin and fails Linux xattr::ENOATTR compilation.",
      "fix": "Retain working sha2/libc requirements and prevent incompatible automated upgrades.",
      "ci_evidence": [
        {
          "pr": 125,
          "job_id": 121348775181,
          "error": "Sha256/Sha384/Sha512 do not implement rsa 0.9 digest/AssociatedOid traits"
        },
        {
          "pr": 126,
          "job_id": 121348843390,
          "error": "cannot find value ENOATTR in crate libc"
        }
      ]
    },
    {
      "id": "R11",
      "priority": "P2",
      "prs": [
        110
      ],
      "description": "PPTX documentation claimed clipping and group compositing were rasterized, although those commands are currently skipped.",
      "fix": "Document actual editable-export limits without claiming raster fallbacks."
    },
    {
      "id": "R12",
      "priority": "P2",
      "prs": [
        124
      ],
      "description": "The library guide still described unauthenticated encrypted files as successful blank renders after F17 changed opening to fail.",
      "fix": "Document PasswordRequired, WrongPassword and UnsupportedEncryption consistently."
    },
    {
      "id": "R13",
      "priority": "P1",
      "prs": [
        107
      ],
      "description": "Fresh review found indirect DP, pending metadata on original streams, JBIG2Globals, encoded-size limits, a trailing separator boundary and missing source validation before stamping.",
      "fix": "Decode original and pending streams against current metadata with bounded reference resolution, inline current globals, enforce encoded limits, separate streams without a trailing byte, and preflight stamping. Strengthen preservation tests with observable fill operations.",
      "regressions": [
        "pending_streams_resolve_decode_parameter_aliases_and_arrays",
        "original_streams_use_pending_filter_and_predictor_metadata",
        "content_limits_charge_encoded_bytes_and_only_between_stream_separators",
        "current_jbig2_globals_are_decoded_and_cycles_are_bounded",
        "failed_decoding_leaves_the_edit_unchanged",
        "encrypted_original_contents_survive_current_stream_decoding"
      ],
      "review_urls": [
        "https://github.com/Xero-Team/zpdf/pull/107#discussion_r4373618887",
        "https://github.com/Xero-Team/zpdf/pull/107#discussion_r4373618892",
        "https://github.com/Xero-Team/zpdf/pull/107#discussion_r4373618894",
        "https://github.com/Xero-Team/zpdf/pull/107#discussion_r4373618900",
        "https://github.com/Xero-Team/zpdf/pull/107#discussion_r4373618909",
        "https://github.com/Xero-Team/zpdf/pull/107#discussion_r4373624717"
      ]
    },
    {
      "id": "R14",
      "priority": "P2",
      "prs": [
        106
      ],
      "description": "The F02 changelog incorrectly promised to preserve choice indices although stale I entries are cleared.",
      "fix": "Document preservation of field values and clearing of stale choice indices.",
      "review_urls": [
        "https://github.com/Xero-Team/zpdf/pull/106#discussion_r4373615067"
      ]
    }
